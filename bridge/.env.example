# Copy to bridge/.env (gitignored). The bridge is the only thing that holds this token.
# Fine-grained token, read-only, or classic token with read:user. Without it the CLI falls back to `gh auth token`.
GITHUB_TOKEN=
# Local timezone used to bucket contributions into days.
PET_TZ=America/Chicago
# Daily contribution goal.
PET_GOAL=20

# MQTT broker (Mosquitto on this Mac). bridge/mosquitto/setup.sh turns MQTT_USER / MQTT_PASS into the broker's
# password file; the box carries the same pair in projects/pet/main/secrets.h.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=pet
MQTT_PASS=
# Minutes between GitHub polls.
PET_POLL_MIN=10

# Local HTTP endpoint where AI tools post session events. Loopback only unless you change the host.
PET_HTTP_HOST=127.0.0.1
PET_HTTP_PORT=8765

# Access from your other machines over Tailscale (petbrain/tailnet.py). Off unless on. The bridge finds this Mac's
# Tailscale address itself and will not listen there without a token of 32 or more random characters, which every
# other machine must send. bridge/setup.py fills these in for you (#40).
PET_TAILNET=off
PET_TAILNET_HOST=
PET_TAILNET_TOKEN=
