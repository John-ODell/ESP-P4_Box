{
  "description": "ESP-P4_Box desk pet: tell the pet when a Codex session needs you, is done, or got its answer.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/Desktop/ESP-P4_Box/bridge/hooks/codex_hook.py", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/Desktop/ESP-P4_Box/bridge/hooks/codex_hook.py", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/Desktop/ESP-P4_Box/bridge/hooks/codex_hook.py", "timeout": 5 }
        ]
      }
    ]
  }
}
