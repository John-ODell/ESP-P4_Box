// Copy to secrets.h (gitignored) and fill in. 2.4 GHz network only: the ESP32-C6 has no 5/6 GHz radio.
#define PET_WIFI_SSID     "your-2.4ghz-ssid"
#define PET_WIFI_PASSWORD "your-password"
// The Mac running bridge/ (Mosquitto). Give the Mac a DHCP reservation or update this when its IP changes.
#define PET_MQTT_URI      "mqtt://10.0.0.65:1883"
#define PET_MQTT_USER     "pet"
#define PET_MQTT_PASS     "see bridge/.env MQTT_PASS"
